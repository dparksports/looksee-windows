<UserControl x:Class="LookSee.Views.BlackHoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Black Hole" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Which processes are still trying to reach the telemetry domains you pinned — caught at the moment they knock."
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="⬇ Export CSV" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ExportBtn_Click"/>
                <Button Content="🗑 Clear History" Style="{StaticResource DangerButton}" Click="ClearBtn_Click"
                        ToolTip="Deletes telemetry_proof.jsonl and resets the counters. The hosts pins themselves are untouched."/>
            </StackPanel>
        </Grid>

        <!-- Protection status: what is actually standing between the apps and their beacons -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Protection status" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProtectionText" Text="Reading the opt-out knowledge base…"
                           TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ComboBox x:Name="RuleCombo" Width="300"
                              ToolTip="Detected apps from the opt-out knowledge base — act on them without leaving this tab."/>
                    <Button x:Name="OptOutRuleBtn" Content="Opt out" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                            Click="OptOutRuleBtn_Click" ToolTip="Applies the vendor's own opt-out switch — written in the exact type the app reads, verified by re-reading, restart-aware."/>
                    <Button x:Name="BlockLogRuleBtn" Content="Block &amp; log" Margin="8,0,0,0" Click="BlockLogRuleBtn_Click"
                            ToolTip="Pins the telemetry domain at 127.0.0.1 (sinkhole): every attempt, from any process, is denied here — and logged in the feed below."/>
                    <Button x:Name="RemoveBlockBtn" Content="Remove block" Margin="8,0,0,0" Click="RemoveBlockBtn_Click"
                            ToolTip="Removes the network pin (works for pins created here or in Shields Up)."/>
                    <Button x:Name="RevertOptOutBtn" Content="Revert opt-out" Margin="8,0,0,0" Click="RevertOptOutBtn_Click"
                            ToolTip="Restores the setting that was in place before the opt-out."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sinkhole state + toggle -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SinkholeStatusText" Text="Checking hosts pins…" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SinkholeDetailText" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                    <ToggleButton x:Name="SinkholeToggle" Grid.Column="1" Content="Black Hole logging: catch every attempt"
                                  VerticalAlignment="Top" MinWidth="240" Click="SinkholeToggle_Click"
                                  ToolTip="Points the telemetry pins at 127.0.0.1 instead of 0.0.0.0, so every attempt completes a TCP handshake to a listener LookSee owns — logged with process, PID and the hostname from the TLS hello — then dropped with no reply."/>
                </Grid>
                <TextBlock x:Name="PinListText" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Counters -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TotalsText" Text="No attempts recorded yet." FontSize="13" FontWeight="SemiBold"/>
                <ItemsControl x:Name="HostnameTotals" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BorderBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,6">
                                <TextBlock FontSize="11">
                                    <Run Text="{Binding Hostname}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Count, StringFormat='  {0} denied'}"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Denied-attempt feed -->
        <DataGrid Grid.Row="4" x:Name="AttemptsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"
                  SelectionChanged="AttemptsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal}" Width="110"/>
                <DataGridTextColumn Header="Hostname attempted" Binding="{Binding Hostname}" Width="220"/>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="160"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                <DataGridTextColumn Header="Denied by" Binding="{Binding DeniedBy}" Width="100"/>
                <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selected-attempt detail -->
        <TextBlock Grid.Row="5" x:Name="DetailText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
