<UserControl x:Class="LookSee.Views.TaskHostSpawnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Taskhostw Spawns" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Sysmon-traced taskhostw launches · the 'why' is the scheduled task behind each one"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ToggleWatchBtn" Content="Start Watch" Style="{StaticResource PrimaryButton}" Click="ToggleWatchBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="PauseBtn" Content="⏸ Pause" Style="{StaticResource PrimaryButton}" Click="PauseBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ClearBtn" Content="🗑 Clear" Style="{StaticResource PrimaryButton}" Click="ClearBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ExportBtn" Content="💾 Export JSONL" Style="{StaticResource PrimaryButton}" Click="ExportBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status + filter -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Watcher is stopped." Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter (regex):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                               ToolTip="Regex over task name (once resolved), command line, parent command line and image path."/>
                    <TextBox x:Name="FilterBox" Width="260" Padding="4" FontFamily="Consolas"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" TextChanged="FilterBox_TextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Spawn grid -->
        <DataGrid Grid.Row="2" x:Name="SpawnGrid" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="SpawnGrid_SelectionChanged" PreviewMouseRightButtonDown="SpawnGrid_PreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <!-- Exited hosts fade so live ones stand out -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Exited}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="InvestigateMenuItem" Header="🧾 Copy investigation report" Click="InvestigateMenuItem_Click"/>
                    <MenuItem x:Name="TracePidMenuItem" Header="🔎 Trace: how was this PID spawned?" Click="TracePidMenuItem_Click"/>
                    <MenuItem x:Name="CopyRowMenuItem" Header="📋 Copy row as JSON" Click="CopyRowMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" SortMemberPath="TimeUtc" Width="80"/>
                <DataGridTemplateColumn Header="Task" Width="300" SortMemberPath="Badge">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,1" HorizontalAlignment="Left"
                                    Background="#2A2A33" Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#E5C77B"
                                           TextTrimming="CharacterEllipsis" MaxWidth="290"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Verdict" Width="90" SortMemberPath="Verdict">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,1" HorizontalAlignment="Left"
                                    Background="{Binding VerdictBackground}" Visibility="{Binding VerdictVisibility}"
                                    ToolTip="Inbox: Microsoft task running Microsoft code · Third-party: custom task or handler outside the system directories · Orphaned: handler DLL is gone">
                                <TextBlock Text="{Binding Verdict}" FontSize="10" Foreground="{Binding VerdictForeground}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                <DataGridTextColumn Header="Life" Binding="{Binding LifeDisplay}" Width="60"/>
                <DataGridTextColumn Header="Exit" Binding="{Binding OutcomeDisplay}" Width="100"
                                    SortMemberPath="OutcomeDisplay"/>
                <DataGridTextColumn Header="Command Line" Binding="{Binding CommandLine}" Width="380">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Parent" Width="170" SortMemberPath="ParentImage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ParentDisplay}" ToolTip="{Binding ParentToolTip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140"/>
                <DataGridTextColumn Header="Integrity" Binding="{Binding IntegrityLevel}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"/>

        <!-- Detail pane -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Record -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailRecordPanel"/>
                </ScrollViewer>
            </Border>

            <!-- Task attribution -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Scheduled task attribution (the 'why')" FontWeight="SemiBold" Margin="0,0,0,6"
                                   ToolTip="Resolved from the Sysmon/task-scheduler event logs: which task launched this taskhostw, why it fired, in what user context, and — for COM-handler tasks — which DLL actually runs."/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Task:" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TaskPathText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Runs as:" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TaskUserText" Text="—" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Handler:" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="COM-handler tasks run a DLL instead of a command line."/>
                            <TextBlock x:Name="TaskHandlerText" Text="—" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Why now:" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="The Task Scheduler event that fired this instance: user logon, its schedule/timer, or a subscribed event."/>
                            <TextBlock x:Name="TaskTriggerText" Text="—" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Outcome:" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="The action's return code and run duration once the scheduler reports completion. Return code 0 in under a second is the 'checked and had nothing to do' signature."/>
                            <TextBlock x:Name="TaskOutcomeText" Text="—" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Verdict:" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="Inbox: Microsoft task path running code from the system directories. Third-party: task outside \Microsoft, or a handler DLL outside them. Orphaned: the handler DLL is no longer registered."/>
                            <TextBlock x:Name="TaskVerdictText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Grid.Row="7" x:Name="KnownTaskText" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" MaxHeight="110" Visibility="Collapsed"
                                 ToolTip="From Assets/known-tasks.json — extend the file to teach the tab new tasks."/>
                        <TextBox Grid.Row="8" x:Name="TaskSummaryText" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="70"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                 Text="Select a spawn row — task details appear here as the event logs catch up."/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
