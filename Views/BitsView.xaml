<UserControl x:Class="LookSee.Views.BitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Deliveries" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Every Background Intelligent Transfer job · where it connects, what it moves, how often, why — and whether it bypasses the firewall"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ToggleWatchBtn" Content="Stop Watch" Style="{StaticResource PrimaryButton}" Click="ToggleWatchBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="PauseBtn" Content="⏸ Pause" Style="{StaticResource PrimaryButton}" Click="PauseBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ClearBtn" Content="🗑 Clear" Style="{StaticResource PrimaryButton}" Click="ClearBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ExportBtn" Content="💾 Export JSONL" Style="{StaticResource PrimaryButton}" Click="ExportBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status + firewall banner + filter -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Starting BITS tracer…" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ShowJobsBtn" Content="📋 Jobs" Style="{StaticResource PrimaryButton}" Click="ShowJobsBtn_Click" Margin="0,0,6,0"/>
                        <Button x:Name="ShowPatternsBtn" Content="📈 Patterns" Style="{StaticResource PrimaryButton}" Click="ShowPatternsBtn_Click" Margin="0,0,12,0"/>
                        <TextBlock Text="Filter (regex):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                                   ToolTip="Regex over job name, URL/host, owner org, creator image and direction."/>
                        <TextBox x:Name="FilterBox" Width="240" Padding="4" FontFamily="Consolas"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" TextChanged="FilterBox_TextChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="FirewallBannerText" Text="Firewall check: pending…"
                           Foreground="#E5A631" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           ToolTip="Whether BITS traffic bypasses this machine's firewall rules: outbound default action, BITS-scoped allow rules, and the structural svchost fact."/>
            </StackPanel>
        </Border>

        <!-- Jobs grid -->
        <DataGrid Grid.Row="2" x:Name="JobsGrid" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="JobsGrid_SelectionChanged" PreviewMouseRightButtonDown="JobsGrid_PreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="completed">
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUpload}" Value="True">
                            <Setter Property="Background" Value="#3A2222"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="InvestigateMenuItem" Header="🧾 Copy investigation report" Click="InvestigateMenuItem_Click"/>
                    <MenuItem x:Name="CopyRowMenuItem" Header="📋 Copy row as JSON" Click="CopyRowMenuItem_Click"/>
                    <MenuItem x:Name="RefreshFirewallMenuItem" Header="🛡 Re-check firewall bypass now" Click="RefreshFirewallMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" SortMemberPath="FirstSeenUtc" Width="105"/>
                <DataGridTextColumn Header="Job" Binding="{Binding Name}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Direction" Width="85" SortMemberPath="Direction">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,1" HorizontalAlignment="Left"
                                    Background="{Binding DirectionBackground}">
                                <TextBlock Text="{Binding Direction}" FontSize="10" Foreground="#E5C77B"
                                           ToolTip="From the live BITS COM queue (event-log-only history shows —). Upload jobs are the T1197 exfiltration vector and always flag Review."/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Verdict" Width="80" SortMemberPath="Verdict">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,1" HorizontalAlignment="Left"
                                    Background="{Binding VerdictBackground}">
                                <TextBlock Text="{Binding Verdict}" FontSize="10" Foreground="#E5C77B"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Created by" Width="170" SortMemberPath="CreatorImage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CreatorDisplay}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding CreatorImage}"/><LineBreak/>
                                        <Run Text="Signed: "/><Run Text="{Binding CreatorSigner}"/>
                                    </TextBlock>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerAccount}" Width="130"/>
                <DataGridTextColumn Header="Host" Binding="{Binding HostDisplay}" SortMemberPath="Host" Width="150"/>
                <DataGridTextColumn Header="IP(s)" Binding="{Binding ResolvedIps}" Width="130"/>
                <DataGridTextColumn Header="Destination owner" Binding="{Binding OrgDisplay}" Width="110"/>
                <DataGridTextColumn Header="Bytes" Binding="{Binding BytesDisplay}" SortMemberPath="BytesTotal" Width="115"/>
                <DataGridTextColumn Header="Files" Binding="{Binding FileCountDisplay}" Width="45"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Patterns grid (same row, visibility-switched; a nested TabControl would inherit the sidebar style) -->
        <DataGrid Grid.Row="2" x:Name="PatternsGrid" Visibility="Collapsed" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Creating process" Binding="{Binding CreatorDisplay}" Width="180"/>
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="220"/>
                <DataGridTextColumn Header="Destination owner" Binding="{Binding OrgDisplay}" Width="130"/>
                <DataGridTextColumn Header="Transfers" Binding="{Binding CountDisplay}" SortMemberPath="JobCount" Width="70"/>
                <DataGridTextColumn Header="Uploads" Binding="{Binding UploadCount}" Width="60"/>
                <DataGridTextColumn Header="Per day" Binding="{Binding PerDayDisplay}" Width="60"/>
                <DataGridTextColumn Header="Regularity" Binding="{Binding RegularityDisplay}" Width="150"
                                    ToolTipService.ShowOnDisabled="True"/>
                <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeenDisplay}" Width="100"/>
                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenDisplay}" SortMemberPath="LastSeenUtc" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"/>

        <!-- Detail pane -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Record + delivered files -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Job record" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel x:Name="DetailRecordPanel"/>
                        <TextBlock Text="Delivered files (size + SHA-256 automatic; content only on explicit preview)" FontWeight="SemiBold" Margin="0,8,0,6"/>
                        <StackPanel x:Name="FilesPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Why + firewall + timeline -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Why this job connects (catalog verdict)" FontWeight="SemiBold" Margin="0,0,0,4"
                               ToolTip="Matched from job name, creating process and destination host against the built-in catalog (BitsReasonCatalog), seeded from the 2026-10-15 triage. Uploads always end at Review."/>
                    <TextBox Grid.Row="1" x:Name="WhyText" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="52" Margin="0,0,0,8"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Text="Select a job row — the explanation, firewall context and event timeline appear here."
                             ToolTip="Select a job row — the explanation, firewall context and event timeline appear here."/>
                    <TextBlock Grid.Row="2" x:Name="FirewallHeadlineText" Text="Firewall: does BITS bypass the rules here?" FontWeight="SemiBold" Foreground="#E5A631" Margin="0,0,0,2"
                               TextWrapping="Wrap"
                               ToolTip="Layered answer: the active profile's default outbound action, explicit allow rules scoped to the BITS service/svchost, and the always-true structural fact that transfers run inside trusted svchost (ATT&amp;CK T1197)."/>
                    <TextBox Grid.Row="3" x:Name="FirewallDetailText" IsReadOnly="True" FontFamily="Consolas" FontSize="10.5" MinHeight="46" Margin="0,0,0,8"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Text="Checking…"/>
                    <ListBox Grid.Row="4" x:Name="TimelineList" FontFamily="Consolas" FontSize="10.5"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
