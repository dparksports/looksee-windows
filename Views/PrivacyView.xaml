<UserControl x:Class="LookSee.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Privacy" Style="{StaticResource PageHeader}"/>
            <TextBlock x:Name="HeaderStatusText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                       Text="Reading data-sharing settings…"/>
            <Button x:Name="RefreshBtn" Grid.Column="2" Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="0.85*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ══ Left: what this machine shares + who receives it ══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Org-managed banner (collapsed when machine is personal) -->
                    <Border x:Name="OrgManagedBanner" Style="{StaticResource CardPanel}" Padding="14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⚠ This machine appears managed by an organization" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AccentAmberBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OrgManagedText" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Your data-sharing settings" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="Read live from this machine — what each setting currently is, what it actually shares, and the supported place to change it. LookSee shows and links; it does not rewrite these (several are tamper- or policy-protected)."/>
                            <ItemsControl x:Name="SettingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Value}" Grid.Column="1" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap" Margin="10,0,0,0"
                                                               HorizontalAlignment="Right" MaxWidth="220" TextAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Plain}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                                <Button Content="{Binding ChangeLabel}" Tag="{Binding ChangeUri}" Click="SettingChange_Click"
                                                        Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="0,6,0,0"
                                                        HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ReadTimestampText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- Vendors -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock Text="Who can receive this data" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="Curated from Microsoft's published documents (verified 2026-10-12). Where Microsoft does not publish names — consumer-Windows vendors — this list says so instead of inventing them. Use 'Exercise your rights' to ask Microsoft directly; that answer is authoritative."/>
                            <ItemsControl x:Name="VendorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Explanation}" Margin="0,3,0,4" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding Entries}" Margin="8,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Padding="0,2">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap"/>
                                                                    <Button Content="source ↗" Tag="{Binding SourceUrl}" Click="OpenSource_Click"
                                                                            Padding="6,1" FontSize="10" Margin="8,0,0,0" Grid.Column="1"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Role}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontSize="10.5" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding SourceLabel}" Foreground="#5A5A62" FontSize="10" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Export -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock Text="Export your evidence" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="A JSON snapshot of everything on this tab (with timestamps) — attach it to a request letter as your machine's state at the time of asking, or keep it to detect drift."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⤓ Export settings snapshot (JSON)" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11"
                                        Click="ExportSnapshot_Click"/>
                                <Button Content="↗ Microsoft privacy dashboard" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="8,0,0,0"
                                        Click="OpenDashboard_Click"
                                        ToolTip="Opens Microsoft's privacy dashboard — activity data, export and delete requests for your Microsoft account."/>
                                <Button Content="↗ Diagnostic Data Viewer docs" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="8,0,0,0"
                                        Click="OpenDdvDocs_Click"
                                        ToolTip="Microsoft's own tool that shows the exact diagnostic events Windows sends."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize"/>

            <!-- ══ Right: request builder + tracker ══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Exercise your rights (US)" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="Two different legal paths. A state privacy law (CCPA and cousins) request goes to Microsoft — the business — including for data its vendors process on its behalf. FOIA applies to federal agencies only, never to companies: it is for records an agency holds about you, e.g. legal process served on Microsoft concerning your data."/>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeCorporate" GroupName="PrivacyMode" Content="Request to Microsoft (CCPA / state law)" IsChecked="True"
                                             Checked="Mode_Changed" Margin="0,0,14,0"/>
                                <RadioButton x:Name="ModeFoia" GroupName="PrivacyMode" Content="FOIA + Privacy Act (agency)"
                                             Checked="Mode_Changed"/>
                            </StackPanel>

                            <!-- Corporate form -->
                            <StackPanel x:Name="CorporatePanel" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Your state:" VerticalAlignment="Center" FontSize="11"/>
                                    <ComboBox x:Name="StateCombo" Grid.Column="1" SelectionChanged="StateCombo_Changed"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Full name:" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBox x:Name="CorpNameBox" Grid.Column="1" Padding="6,4"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Email:" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBox x:Name="CorpEmailBox" Grid.Column="1" Padding="6,4"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Device(s):" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBox x:Name="CorpDevicesBox" Grid.Column="1" Padding="6,4"
                                             ToolTip="E.g. 'Dell XPS 15, Windows device name DESKTOP-ABC123' — identifies which machine's data you mean."/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Period from:" VerticalAlignment="Center" FontSize="11"/>
                                    <DatePicker x:Name="FromDatePick" Grid.Column="1" Width="130"/>
                                    <TextBlock Text="to:" Grid.Column="2" Margin="8,0,8,0" VerticalAlignment="Center" FontSize="11"/>
                                    <DatePicker x:Name="ToDatePick" Grid.Column="3" Width="130"/>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="RightKnowCats" Content="Know: categories" IsChecked="True" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="RightKnowSpecific" Content="Know: specific data" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="RightDelete" Content="Delete" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="RightCorrect" Content="Correct" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="RightOptOut" Content="Opt out of sale/share"/>
                                </WrapPanel>
                                <CheckBox x:Name="IncludeSnapshotCheck" IsChecked="True" Margin="0,6,0,0"
                                          Content="Attach this machine's current settings (read above) for reference"/>
                                <TextBlock x:Name="StateLawNoteText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" TextWrapping="Wrap" Text=""/>
                            </StackPanel>

                            <!-- FOIA form -->
                            <StackPanel x:Name="FoiaPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agency:" VerticalAlignment="Center" FontSize="11"/>
                                    <ComboBox x:Name="AgencyCombo" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Full name:" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBox x:Name="FoiaNameBox" Grid.Column="1" Padding="6,4"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Email:" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBox x:Name="FoiaEmailBox" Grid.Column="1" Padding="6,4"/>
                                </Grid>
                                <TextBlock Text="Records you seek (be specific):" Margin="0,6,0,2" FontSize="11"/>
                                <TextBox x:Name="FoiaDescBox" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="[e.g. any legal process, national security letters, or formal information requests served on Microsoft Corporation concerning my accounts, identifiers, or devices]"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="FeeWaiverCheck" Content="Request fee waiver" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="ExpeditedCheck" Content="Request expedited processing"/>
                                </StackPanel>
                                <TextBlock x:Name="AgencyNoteText" Margin="0,8,0,0" Foreground="{DynamicResource AccentCyanBrush}"
                                           FontSize="10.5" TextWrapping="Wrap" Text=""/>
                            </StackPanel>

                            <Button x:Name="GenerateBtn" Content="✎ Generate draft letter" Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0" HorizontalAlignment="Left" Click="GenerateBtn_Click"/>

                            <!-- Preview + actions -->
                            <TextBlock Text="Draft — review and edit before sending. LookSee never sends anything; this is not legal advice."
                                       Margin="0,10,0,4" Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            <TextBox x:Name="LetterBox" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Height="280" Padding="8" IsReadOnly="False"
                                     SpellCheck.IsEnabled="True"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="⧉ Copy" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Click="CopyLetter_Click"/>
                                <Button Content="💾 Save as .txt" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="8,0,0,0" Click="SaveLetter_Click"/>
                                <Button x:Name="OpenRecipientBtn" Content="↗ Open recipient's request page" Style="{StaticResource PrimaryButton}"
                                        Padding="10,4" FontSize="11" Margin="8,0,0,0" Click="OpenRecipient_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tracker -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock Text="Request tracker" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="Local-only log (no sync, no cloud). Due dates use each statute's response window; overdue rows are amber."/>
                            <DataGrid x:Name="RequestsGrid" MinHeight="120" MaxHeight="220"
                                      VirtualizingPanel.IsVirtualizing="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" Width="90"/>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="75"/>
                                    <DataGridTextColumn Header="Recipient / statute" Binding="{Binding Recipient}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding Recipient}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                                    <DataGridTextColumn Header="Due" Binding="{Binding DueDisplay}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="✓ Mark sent" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Click="MarkSent_Click"/>
                                <Button Content="✓ Mark answered" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0" Click="MarkAnswered_Click"/>
                                <Button Content="✕ Remove" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0" Click="RemoveRequest_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
