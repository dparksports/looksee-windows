<UserControl x:Class="LookSee.Views.DefenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Defender" Style="{StaticResource PageHeader}"/>
            <TextBlock x:Name="HeaderStatusText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                       Text="Reading Defender state…"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="QuickScanBtn" Content="▶ Quick Scan" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="QuickScanBtn_Click"
                        ToolTip="Starts a quick scan (detached — watch it appear in Scans and the resource strip below)."/>
                <Button x:Name="FullScanBtn" Content="▶ Full Scan" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="FullScanBtn_Click"
                        ToolTip="Starts a full scan. Can run a long time — progress shows in Scans."/>
                <Button x:Name="UpdateSigBtn" Content="⤓ Update Definitions" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="UpdateSigBtn_Click"/>
                <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Two columns: status & controls | monitoring, separated by a
             draggable divider so the event log can be widened -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="0.9*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: status & controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Engine status -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Engine status" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="EngineStatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Text="—"/>
                            <TextBlock x:Name="VersionsText" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="—"/>
                        </StackPanel>
                    </Border>

                    <!-- Live resources -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Live resources (MsMpEng)" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="ResourceText" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Text="sampling…"/>
                            <TextBlock x:Name="SparkText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="16"
                                       Foreground="{DynamicResource AccentCyanBrush}" Text=""/>
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="CPU is MsMpEng's share of total machine capacity, sampled every 2 s; the sparkline covers the last 5 minutes. Real-time protection shows up here as short spikes whenever files change; sustained high CPU during builds usually means the engine is scanning compiler output — see Exclusions below."/>
                        </StackPanel>
                    </Border>

                    <!-- Recent scans -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Scans" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="ScansText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Text="No scans recorded in the recent event history."/>
                            <ItemsControl x:Name="ScansList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Performance controls -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Performance" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="PrefStatusText" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Text="—"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Scan CPU cap:" Foreground="{DynamicResource TextSecondaryBrush}" Width="150" VerticalAlignment="Center"/>
                                <Slider x:Name="DefenderCpuSlider" Width="220" Minimum="5" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" ValueChanged="DefenderCpuSlider_ValueChanged"
                                        ToolTip="Average CPU % Defender's scan engine may use (5–100). Windows default: 50."/>
                                <TextBlock x:Name="DefenderCpuValueText" Text="—" Width="110" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="🐢 Gentle (10)" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="0,0,6,0" Click="DefenderPresetBtn_Click" Tag="10"/>
                                    <Button Content="⚖ Balanced (25)" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="0,0,6,0" Click="DefenderPresetBtn_Click" Tag="25"/>
                                    <Button Content="🏷 Default (50)" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="0,0,6,0" Click="DefenderPresetBtn_Click" Tag="50"/>
                                    <Button Content="🚀 Fast (100)" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Click="DefenderPresetBtn_Click" Tag="100"/>
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox x:Name="IdleScanCheck" Margin="0,10,0,0"
                                      Content="Run scheduled scans only when the PC is idle"
                                      Checked="IdleScanCheck_Changed" Unchecked="IdleScanCheck_Changed"/>
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="Lower CPU caps keep the machine responsive during scans in exchange for scans taking longer — this mainly throttles scheduled and full scans. Idle-only scanning has no such trade-off: Defender simply waits for a moment you won't notice."/>
                        </StackPanel>
                    </Border>

                    <!-- Exclusions (read-only) -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Exclusions (read-only)" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="DefenderExclusionSummaryText" Grid.Column="1" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text=""/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Paths" FontSize="11" FontWeight="SemiBold" Margin="6,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ExclPathsList" Margin="6,0,6,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Processes" FontSize="11" FontWeight="SemiBold" Margin="6,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ExclProcsList" Margin="6,0,6,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Extensions" FontSize="11" FontWeight="SemiBold" Margin="6,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ExclExtsList" Margin="6,0,6,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button Content="🛡 Add exclusions in Windows Security ↗" Style="{StaticResource PrimaryButton}"
                                    Padding="8,2" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Click="OpenSecurityExclusions_Click"
                                    ToolTip="Opens Windows Security at Virus &amp; threat protection settings — 'Add or remove exclusions' lives there. LookSee itself never writes exclusions."/>
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="Defender skips everything on these lists entirely — malware placed in an excluded path, or written by an excluded process, is not scanned. This view is read-only on purpose: adding antivirus exclusions is a classic malware technique, so LookSee shows you what is excluded but never changes it. To add one yourself, use the button above — it opens Windows Security at Virus &amp; threat protection settings, where Exclusions lives (admin PowerShell: Add-MpPreference works too). Prefer the narrowest path that solves your problem — e.g. your build output (obj\bin, node_modules) rather than a whole drive — because every exclusion is a place malware can live unscanned."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Divider: drag to widen/narrow the event log -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the event log"/>

            <!-- Right: activity feed -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Activity (live from Defender's event log)" Style="{StaticResource SectionHeader}"/>
                        <DataGrid Grid.Row="1" x:Name="ActivityGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" MinHeight="300"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="105"/>
                                <DataGridTemplateColumn Header="Kind" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kind}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#E5A631"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Summary" Binding="{Binding SummaryFirstLine}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                                            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
