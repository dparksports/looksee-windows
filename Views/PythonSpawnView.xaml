<UserControl x:Class="LookSee.Views.PythonSpawnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Python Spawns" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Sysmon-traced python launches · call stacks for instrumented environments · TLS plaintext of what they send"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ToggleWatchBtn" Content="Start Watch" Style="{StaticResource PrimaryButton}" Click="ToggleWatchBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="PauseBtn" Content="⏸ Pause" Style="{StaticResource PrimaryButton}" Click="PauseBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ClearBtn" Content="🗑 Clear" Style="{StaticResource PrimaryButton}" Click="ClearBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ExportBtn" Content="💾 Export JSONL" Style="{StaticResource PrimaryButton}" Click="ExportBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="InstrumentBtn" Content="🐍 Instrument…" Style="{StaticResource PrimaryButton}" Click="InstrumentBtn_Click"
                        ToolTip="Opt-in per environment: install the audit hook that reports Python stacks at spawn and TLS session keys."/>
            </StackPanel>
        </Grid>

        <!-- Status + filter -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Watcher is stopped." Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Filter (regex):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                               ToolTip="Regex over command line, parent command line and image path — the 'why' search (e.g. 'pip|pytest|http')"/>
                    <TextBox x:Name="FilterBox" Width="220" Padding="4" FontFamily="Consolas"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" TextChanged="FilterBox_TextChanged"/>
                    <CheckBox x:Name="KeylogCheck" Content="TLS keylogging" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}" Checked="KeylogCheck_Changed" Unchecked="KeylogCheck_Changed"
                              ToolTip="When on, instrumented pythons log TLS session keys (user-only-ACL file, rotated at 5 MB). Turning it off wipes the key file and stops the hook from creating one."/>
                    <CheckBox x:Name="PersistFlowsCheck" Content="Persist flows" IsChecked="False" Margin="12,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}" Checked="PersistFlows_Changed" Unchecked="PersistFlows_Changed"
                              ToolTip="Write finalized flows (base64 payloads) under %LOCALAPPDATA%\LookSee\pytrace\flows — size-capped with rotation."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Spawn grid -->
        <DataGrid Grid.Row="2" x:Name="SpawnGrid" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="SpawnGrid_SelectionChanged" PreviewMouseRightButtonDown="SpawnGrid_PreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <!-- Exited processes fade so live spawns stand out -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Exited}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="CopyRowMenuItem" Header="📋 Copy row as JSON" Click="CopyRowMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" SortMemberPath="TimeUtc" Width="80"/>
                <DataGridTemplateColumn Header="Badge" Width="56" SortMemberPath="Badge">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,1" HorizontalAlignment="Left"
                                    Background="{Binding BadgeBackground}" Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#7EB8F7"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                <DataGridTextColumn Header="Life" Binding="{Binding LifeDisplay}" Width="60"/>
                <DataGridTemplateColumn Header="Image" Width="170" SortMemberPath="Image">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ImageDisplay}" ToolTip="{Binding Image}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Command Line" Binding="{Binding CommandLine}" Width="360">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Parent" Width="170" SortMemberPath="ParentImage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ParentDisplay}" ToolTip="{Binding ParentToolTip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140"/>
                <DataGridTextColumn Header="Integrity" Binding="{Binding IntegrityLevel}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"/>

        <!-- Detail pane -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Record -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailRecordPanel"/>
                </ScrollViewer>
            </Border>

            <!-- Stack at spawn -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Stack at spawn (audit hook)" FontWeight="SemiBold" Margin="0,0,0,6"
                               ToolTip="Python call stacks recorded inside the process when a spawn API fired. Requires the environment to be instrumented (Instrument… button)."/>
                    <TextBox Grid.Row="1" x:Name="StackText" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Text=""/>
                </Grid>
            </Border>

            <!-- Network & TLS -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Network — TCP flows of this PID" FontWeight="SemiBold" Margin="0,0,0,4"
                               ToolTip="Flows attributed by endpoint at connect time (Sysmon EID 3). Select a flow and decrypt when the environment is instrumented. Loopback and IPv6 are invisible to the NIC-level capture."/>
                    <ListBox Grid.Row="1" x:Name="FlowList" Height="86" Margin="0,0,0,6" FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             SelectionChanged="FlowList_SelectionChanged"/>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <ComboBox x:Name="PlainViewCombo" DockPanel.Dock="Right" Width="70" SelectedIndex="0" SelectionChanged="PlainViewCombo_SelectionChanged">
                                <ComboBoxItem Content="text"/>
                                <ComboBoxItem Content="hex"/>
                            </ComboBox>
                            <Button x:Name="DecryptBtn" Content="🔓 Decrypt selected flow" Style="{StaticResource PrimaryButton}"
                                    Click="DecryptBtn_Click" Margin="0,0,8,0"/>
                        </DockPanel>
                        <TextBox Grid.Row="1" x:Name="PlainText" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Text=""/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
