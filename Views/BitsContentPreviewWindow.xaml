<Window x:Class="LookSee.Views.BitsContentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BITS delivered-file preview — read-only"
        Width="920" Height="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="—" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="FileMetaText" Text="—" FontFamily="Consolas" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox Grid.Row="2" x:Name="ContentText" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>

        <TextBlock Grid.Row="3" Text="Explicit content inspection — this window is the only place BITS file content is read. The preview is in-memory only: nothing is written to disk, exported, or sent anywhere."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
