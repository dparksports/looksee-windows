<Window x:Class="LookSee.Views.ProcessTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PID Inquiry" Width="940" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + verdict -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="PID Inquiry" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="How was this process spawned? Ancestry chain, spawn mechanism and corroborating records — with PID-reuse checks before any parent is trusted."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,0"/>
            <Border x:Name="VerdictBanner" Background="#1A4A8A" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="VerdictKindText" Text="Collecting…" Foreground="#7EB8F7" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="VerdictDetailText" Foreground="#B9D4F5" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Identity -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,28,6">
                        <TextBlock Text="PROCESS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentName" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,6">
                        <TextBlock Text="PID" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentPid" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,6">
                        <TextBlock Text="STARTED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentCreated" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,6">
                        <TextBlock Text="OWNER" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentOwner" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,6">
                        <TextBlock Text="SESSION" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentSession" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="MEMORY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="IdentMemory" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="IdentImage" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="IdentCmd" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <!-- "What is this process?" — plain-English gloss for
                     helper names that mean nothing on their own -->
                <TextBlock x:Name="IdentGloss" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Spawn chain -->
        <TextBlock Grid.Row="2" Text="SPAWN CHAIN (child → root · red links failed the PID-reuse check)"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChainList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Arrow}" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding Head}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Verified}" Value="False">
                                                <Setter Property="Foreground" Value="#F2A0B4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Cmd}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Note}" Foreground="#FBBF24" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Evidence + warnings -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="EVIDENCE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EvidenceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                                    <!-- Mode=OneWay is required: Run.Text bindings default
                                         to TwoWay, which throws on read-only VM properties. -->
                                    <Run Text="{Binding Source, Mode=OneWay}" FontWeight="SemiBold" Foreground="#7EB8F7"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding Detail, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="WarningsText" Foreground="#FBBF24" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Buttons + status -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="↻ Re-collect" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="RefreshBtn_Click" Margin="0,0,8,0"/>
            <Button Content="📋 Copy report" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="CopyBtn_Click" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text="Collecting… (WMI snapshot, parent chain, Sysmon events, shell history)"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
