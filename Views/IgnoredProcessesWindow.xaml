<Window x:Class="LookSee.Views.IgnoredProcessesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ignore lists" Width="640" Height="560"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ignored processes" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,22,0,0"
                   Text="Matched on the exe file name, case-insensitively. Hidden from every feed and the Phone Bill. Editable here or in ignored_processes.txt next to LookSee.exe."/>
        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ProcessList" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     FontFamily="Consolas" FontSize="12" SelectionChanged="ProcessList_SelectionChanged"/>
            <Button x:Name="RemoveProcBtn" Grid.Column="1" Content="Remove" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" Click="RemoveProcBtn_Click" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top">
                <TextBox x:Name="NewProcBox" Width="150" Padding="4" FontFamily="Consolas"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" KeyDown="NewProcBox_KeyDown"/>
                <Button Content="Add" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" Click="AddProcBtn_Click"
                        ToolTip="Example: someapp.exe"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Ignored apps (Who's Talking)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,22,0,0"
                   Text="Matched on the full image path. No encrypted-upload toasts or suggestions for these apps; their rows stay in the grid."/>
        <ListBox Grid.Row="3" x:Name="AppList" Margin="0,8,0,12" Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                 FontFamily="Consolas" FontSize="11"/>

        <DockPanel Grid.Row="4" Margin="0,4,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="🔔 Reset don't-ask-again" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Click="ResetConfirmsBtn_Click"
                        ToolTip="Re-arms every block confirmation prompt ('I want the warnings back'). Per warning class — the routine IP confirm never silenced the svchost warning."/>
                <Button x:Name="UnignoreAppBtn" Content="Un-ignore app" Style="{StaticResource PrimaryButton}"
                        Click="UnignoreAppBtn_Click"/>
            </StackPanel>
            <TextBlock Text="LookSee.exe is always ignored and not listed." FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
