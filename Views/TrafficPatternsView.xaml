<UserControl x:Class="LookSee.Views.TrafficPatternsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LookSee.Converters"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <converters:GroupExpandedStateConverter x:Key="GroupExpandedState"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Phone Bill" Style="{StaticResource PageHeader}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="⬇ Export CSV" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ExportBtn_Click"/>
                <Button Content="🗑 Clear History" Style="{StaticResource DangerButton}" Click="ClearBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Window:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="WindowCombo" Width="150" Margin="0,0,16,0" SelectionChanged="WindowChanged" SelectedIndex="2">
                <ComboBoxItem Content="Last 5 minutes"/>
                <ComboBoxItem Content="Last hour"/>
                <ComboBoxItem Content="Last 24 hours"/>
                <ComboBoxItem Content="All time"/>
            </ComboBox>

            <TextBlock Text="Filter:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="FilterBox" Width="220" Margin="0,0,16,0" TextChanged="FilterBox_TextChanged"
                     ToolTip="Regex over process, destination IP and hostname"/>

            <CheckBox x:Name="LiveCheck" Content="Auto-Refresh" IsChecked="True"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"
                      Checked="LiveChanged" Unchecked="LiveChanged"/>
            <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
        </StackPanel>

        <!-- Patterns Grid -->
        <DataGrid Grid.Row="2" x:Name="PatternsGrid" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="{Binding Converter={StaticResource GroupExpandedState}, Mode=OneWay}"
                                                  Expanded="GroupExpander_StateChanged" Collapsed="GroupExpander_StateChanged"
                                                  Background="{DynamicResource SurfaceAltBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Expander.Header>
                                                <TextBlock FontWeight="SemiBold" FontSize="12" Padding="4"
                                                           Text="{Binding Name, StringFormat='{} {0}'}"/>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Destination IP" Binding="{Binding DestIp}" Width="130"/>
                <DataGridTemplateColumn Header="Hostname" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Hostname}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="FontStyle"  Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="FontStyle"  Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ports" Binding="{Binding PortsDisplay}" Width="70"/>
                <DataGridTextColumn Header="Sent" Binding="{Binding TxDisplay}" Width="90"/>
                <DataGridTextColumn Header="Received" Binding="{Binding RxDisplay}" Width="90"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="90"/>
                <DataGridTextColumn Header="Flows" Binding="{Binding FlowsDisplay}" Width="60"/>
                <DataGridTextColumn Header="Avg Rate" Binding="{Binding RateDisplay}" Width="100"/>
                <DataGridTemplateColumn Header="24h Pattern" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding PatternHint}">
                                <TextBlock Text="{Binding PatternDisplay}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource AccentCyanBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PatternHint}" Margin="8,0,0,0"
                                           Foreground="#E5A631" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenDisplay}" Width="90"/>
                <DataGridTextColumn Header="PIDs" Binding="{Binding PidsDisplay}" Width="120"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Row (JSON)" Click="CopyRowMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="Starting…" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
