<UserControl x:Class="LookSee.Views.SvchostTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Svchost Trace &amp; Patterns" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Spawn genealogy · connection timeline · destination classification · beacon detection"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="StartTraceBtn" Content="▶ Start Trace" Style="{StaticResource PrimaryButton}" Click="StartTraceBtn_Click" Margin="0,0,8,0"/>
                <Button Content="🔍 Analyze Patterns" Style="{StaticResource PrimaryButton}" Click="AnalyzeBtn_Click" Margin="0,0,8,0"/>
                <Button Content="⬇ Export JSONL" Style="{StaticResource PrimaryButton}" Click="ExportBtn_Click" Margin="0,0,8,0"/>
                <Button Content="✕ Clear" Style="{StaticResource PrimaryButton}" Click="ClearBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TraceStatusText" Text="Trace is stopped. Start to capture svchost spawns, connections and byte flows."
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#1A4A8A" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="EventsChip" Text="events: 0" Foreground="#7EB8F7" FontSize="11" FontFamily="Consolas"/>
                </Border>
                <Border Grid.Column="2" Background="#3A1520" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock x:Name="FlagsChip" Text="flags: 0" Foreground="#F2A0B4" FontSize="11" FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>

        <!-- Capture service strip: start/stop the headless collector, toggle
             boot auto-start (per-user LIMITED scheduled task), analyze saved traces -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CaptureDot" Width="8" Height="8" Fill="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CaptureStatusText" Text="Capture: stopped · auto-start: off"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="StartCaptureBtn" Content="▶ Start" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="StartCaptureBtn_Click" Margin="0,0,8,0"/>
                    <Button x:Name="StopCaptureBtn" Content="⏹ Stop" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="StopCaptureBtn_Click" Margin="0,0,16,0"/>
                    <CheckBox x:Name="AutoStartToggle" Content="Auto-start on boot" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"
                              Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed"
                              ToolTip="Starts the headless capture at logon via your user Run key (no admin needed). Off = remove the entry."/>
                    <Button Content="📂 Captures" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="OpenFolderBtn_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="TracesCombo" Width="250" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                    <Button x:Name="AnalyzeFileBtn" Content="🔍 Analyze File" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="AnalyzeFileBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Event timeline -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="TraceGrid" SelectionMode="Single" IsReadOnly="True"
                      FontFamily="Consolas" FontSize="11">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="FLAG">
                                <Setter Property="Foreground" Value="#F2A0B4"/>
                                <Setter Property="Background" Value="#2A0F18"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="spawn">
                                <Setter Property="Foreground" Value="#7ED8A0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="exit">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"         Binding="{Binding Time}"        Width="80"/>
                    <DataGridTextColumn Header="Type"         Binding="{Binding Type}"        Width="90"/>
                    <DataGridTextColumn Header="PID"          Binding="{Binding Pid}"         Width="60"/>
                    <DataGridTextColumn Header="Service(s)"   Binding="{Binding Services}"    Width="180"/>
                    <DataGridTextColumn Header="Parent"       Binding="{Binding Parent}"      Width="110"/>
                    <DataGridTextColumn Header="Destination"  Binding="{Binding Destination}" Width="170"/>
                    <DataGridTextColumn Header="Detail"       Binding="{Binding Detail}"      Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- Shown only while stopped with no rows — a passive tab must
                 read as "not tracing", not as broken detection. -->
            <TextBlock x:Name="EmptyHint"
                       Text="Trace is stopped — press ▶ Start Trace to begin capturing. The grid fills only while a trace is running; spawns and connections are recorded from the moment it starts."
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Visible"/>
        </Grid>

        <!-- Analysis report -->
        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="8">
            <TextBox x:Name="AnalysisBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Text="Pattern analysis report appears here — press Analyze Patterns (auto-refreshes every 30s while tracing)."/>
        </Border>
    </Grid>
</UserControl>
