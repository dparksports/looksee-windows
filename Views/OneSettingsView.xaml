<UserControl x:Class="LookSee.Views.OneSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Windows Check-Ins" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="How often Windows fetches OneSettings remote config (feature flags, experiment cohorts) — and proof it is actually holding." 
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Live status -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Live task state" Style="{StaticResource SectionHeader}"/>
                            <Button Grid.Column="1" Content="↻ Refresh" Padding="10,2" Margin="0,0,0,8"
                                    Click="RefreshBtn_Click"/>
                        </Grid>

                        <TextBlock x:Name="LiveStateText" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="…"/>

                        <!-- Drift banner (visible only when live != saved cadence) -->
                        <Border x:Name="DriftBanner" Grid.Row="2" Margin="0,10,0,0" Padding="10,8"
                                Background="#22FBBF24" BorderBrush="{DynamicResource AccentAmberBrush}"
                                BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="DriftText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button Content="Re-apply saved cadence" Style="{StaticResource PrimaryButton}"
                                        Margin="0,8,0,0" Padding="10,2" Click="ReapplyBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="The inbox task \Microsoft\Windows\Flighting\OneSettings\RefreshCache runs as SYSTEM via a COM handler. Windows servicing rewrites inbox task definitions — this machine's StartBoundary was rewritten by the OS the day this tab was built — so the saved cadence is re-checked every time this tab opens."/>
                    </Grid>
                </Border>

                <!-- Cadence control -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Cadence" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBlock Text="Fetch interval:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CadenceCombo" Width="230" SelectionChanged="CadenceCombo_SelectionChanged">
                                <ComboBoxItem Content="Stock (unchanged)" Tag="stock"/>
                                <ComboBoxItem Content="6 h" Tag="6"/>
                                <ComboBoxItem Content="12 h" Tag="12"/>
                                <ComboBoxItem Content="24 h (recommended)" Tag="24"/>
                                <ComboBoxItem Content="48 h" Tag="48"/>
                                <ComboBoxItem Content="72 h" Tag="72"/>
                                <ComboBoxItem Content="Custom…" Tag="custom"/>
                            </ComboBox>
                            <TextBox x:Name="CustomCadenceBox" Width="110" Margin="8,0,0,0" Visibility="Collapsed"
                                     ToolTip="Plain hours (36), clock (06:00:00) or ISO 8601 (PT36H)"
                                     TextChanged="CustomCadenceBox_TextChanged"/>
                            <TextBlock x:Name="CustomCadenceHint" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"
                                       Text="hours, HH:MM:SS or PT36H"/>
                        </StackPanel>

                        <TextBlock x:Name="RangeWarningText" Grid.Row="2" Margin="0,4,0,4" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentAmberBrush}" Text="" Visibility="Collapsed"/>

                        <StackPanel Grid.Row="3" Margin="0,4,0,4">
                            <CheckBox x:Name="WatchdogCheck" IsChecked="True"
                                      Content="Watchdog — re-apply the cadence daily and at logon (Windows servicing reverts this task)"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <CheckBox x:Name="KeepWnfCheck" IsChecked="False"
                                      Content="Keep the WNF state-change triggers (they add extra fetches when Windows state changes)"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,4">
                            <Button Content="Preview changes" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Padding="12,4" Click="PreviewBtn_Click"/>
                            <Button x:Name="ApplyBtn" Content="Apply" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Padding="12,4" IsEnabled="False" Click="ApplyBtn_Click"/>
                            <Button Content="Restore stock" Margin="0,0,8,0" Padding="12,4" Click="RestoreBtn_Click"/>
                            <ComboBox x:Name="BackupCombo" Width="290" Margin="4,0,0,0"
                                      ToolTip="Backup used by 'Restore stock' (newest by default)"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Orientation="Horizontal">
                            <TextBlock x:Name="ApplyStatusText" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text=""/>
                            <Button x:Name="AuditLink" Content="audit trail…" Margin="12,0,0,0" Padding="4,1" FontSize="11"
                                    Visibility="Collapsed" Click="AuditLink_Click"
                                    ToolTip="Every change this tool makes is one JSONL line — open it"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Observed runs / compliance -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Is it actually holding? (observed vs expected)" Style="{StaticResource SectionHeader}"/>

                        <TextBlock x:Name="ComplianceText" Grid.Row="1" Margin="0,8,0,4" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="…"/>

                        <ListBox x:Name="RunsList" Grid.Row="2" Height="160" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Every launch Task Scheduler recorded for this task, bucketed by why it fired. Timer runs above expectation mean the stock cadence was live for part of the window (servicing reverted it — re-apply, and keep the watchdog on). Event/WNF and manual runs are not timer drift: they are other actors starting the task, which the watchdog cannot prevent — a fetch that bypasses the task entirely (a service calling the OneSettings client API in-process) is invisible here but would still show as svchost traffic in Who's Talking."/>
                    </Grid>
                </Border>

                <!-- Live external starts -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Live external starts — something calling Run() on the task" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
                            <Ellipse x:Name="WatchDot" Width="8" Height="8" Fill="{DynamicResource AccentGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WatchStatusText" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="starting live watch…"/>
                        </StackPanel>

                        <ListBox x:Name="ExternalStartsList" Grid.Row="2" Height="130" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="While this tab is open, every launch that fires with no trigger (timer, WNF or logon all absent) is flagged here within seconds, with the destinations its taskhostw instance connected to (Sysmon evidence). The scheduler log does not name the caller — this proves what the external start did, not who asked. Trigger-fired launches are not alerted (the card above counts them). Watching is read-only and stops when the tab closes."/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
