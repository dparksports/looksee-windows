<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the OneSettingsCadence CLI's pure logic: interval
       parsing round-trips, the Triggers XML transform (including the Duration
       and missing-RandomDelay branches the live task on this machine cannot
       exercise — its XML has no Duration and always carries a RandomDelay),
       and drift detection. No COM, no writes, no elevation. The engine is
       linked via ProjectReference, so what runs here is byte-identical to the
       CLI and the app tab. Run: dotnet run with this project path as the argument -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OneSettingsCadenceSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneSettingsCadence\OneSettingsCadence.Core\OneSettingsCadence.Core.csproj" />
  </ItemGroup>

</Project>
