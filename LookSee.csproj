<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2026.10.22</Version>
    <AssemblyName>LookSee</AssemblyName>
    <Product>LookSee</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <!-- Suppress duplicate-attribute CS0579 from the WPF XAML designer _wpftmp project -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="System.Management" Version="10.0.0-preview.4.25258.110" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0-preview.4.25258.110" />
  </ItemGroup>

  <ItemGroup>
    <!-- The svchost capture/analysis engine, linked in-process: the app runs
         it directly instead of spawning a bundled child exe (which SmartScreen
         hard-blocks on download extracts). Vendored in-repo at svchost-watch\.
         The standalone CLI exe is not built or shipped. -->
    <ProjectReference Include="svchost-watch\SvchostAnalyzer.Core\SvchostAnalyzer.Core.csproj" />
    <!-- OneSettings cadence engine, linked in-process for the Windows
         Check-Ins tab (the CLI exe builds separately over the same Core
         project). -->
    <ProjectReference Include="OneSettingsCadence\OneSettingsCadence.Core\OneSettingsCadence.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
    <!-- The python audit-hook payload: embedded, read via
         Assembly.GetManifestResourceStream by PyTraceInstallerService — never
         written to disk as a standalone app file. -->
    <EmbeddedResource Include="Assets\PyTraceHook.py" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\telemetry_rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Plain-English explanations for known scheduled tasks (Taskhostw
         feed in Who Started It). User-extensible: add path-keyed entries
         and restart. -->
    <Content Include="Assets\known-tasks.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Self-test harnesses: link the app's services themselves and have
         their own Main() — excluded from the app assembly, built separately
         (dotnet build <name>\<name>.csproj). -->
    <Compile Remove="PyTraceSelfTest\**" />
    <Compile Remove="TaskAttributionSelfTest\**" />
    <Compile Remove="OneSettingsCadenceSelfTest\**" />
    <Compile Remove="BitsTraceSelfTest\**" />
    <Compile Remove="NetWatchSelfTest\**" />
    <!-- Vendored engine: compiled through its own ProjectReference — without
         this exclusion the default glob would pull its .cs into the app
         assembly too (duplicate types, and the CLI's top-level Program). -->
    <Compile Remove="svchost-watch\**" />
    <!-- OneSettings cadence CLI — standalone console tool for the inbox
         OneSettings RefreshCache task, built separately; own Main() -->
    <Compile Remove="OneSettingsCadence\**" />
  </ItemGroup>

  <!-- ── Versioning: <Version> above is the single source of truth ──
       GenerateAssemblyInfo stays false (WPF designer CS0579 workaround), so this
       target generates the assembly version attributes from <Version> into obj\
       at build time. Properties\AssemblyInfo.cs deliberately carries none — never
       hand-add AssemblyVersion/FileVersion/InformationalVersion anywhere; bump
       <Version> and everything else follows. -->
  <Target Name="GenerateVersionAssemblyInfo" BeforeTargets="BeforeCompile">
    <Error Condition="'$(Version)' == ''"
           Text="GenerateVersionAssemblyInfo: &lt;Version&gt; is empty — it is the single source of truth and must be set." />
    <PropertyGroup>
      <Version4>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^\d+\.\d+\.\d+$', '$0.0'))</Version4>
      <GeneratedVersionFile>$(IntermediateOutputPath)GeneratedVersionInfo.cs</GeneratedVersionFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <ItemGroup>
      <GeneratedVersionLines Include="// Auto-generated from &lt;Version&gt; in LookSee.csproj — do not edit." />
      <GeneratedVersionLines Include="using System.Reflection%3B" />
      <GeneratedVersionLines Include="[assembly: AssemblyVersion(&quot;$(Version4)&quot;)]" />
      <GeneratedVersionLines Include="[assembly: AssemblyFileVersion(&quot;$(Version4)&quot;)]" />
      <GeneratedVersionLines Include="[assembly: AssemblyInformationalVersion(&quot;$(Version)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(GeneratedVersionFile)" Lines="@(GeneratedVersionLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(GeneratedVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
