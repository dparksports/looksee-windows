<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the Python Spawns tab's non-UI engine. Compiles
       the WPF-free services from the app project directly, so what runs here
       is byte-identical to what ships in LookSee. Excluded from the app
       build (LookSee.csproj Compile Remove, like ScratchTest): it has its
       own Main() and would double-define the linked service classes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PyTraceSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Services\TcpStreamCaptureService.cs" />
    <Compile Include="..\Services\TlsKeylogService.cs" />
    <Compile Include="..\Services\TlsDecryptor.cs" />
    <Compile Include="..\Services\PyTraceInstallerService.cs" />
    <Compile Include="..\Services\PyTraceReaderService.cs" />
    <Compile Include="..\Models\TcpFlowRecord.cs" />
    <Compile Include="..\Models\TlsDecryptResult.cs" />
    <Compile Include="..\Models\PyTraceRecord.cs" />
  </ItemGroup>

</Project>
