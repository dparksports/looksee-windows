<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OneSettingsCadence</AssemblyName>
    <Product>OneSettingsCadence</Product>
    <Company>LookSee</Company>
    <Description>CLI face of the LookSee OneSettings cadence control — slows the Windows inbox task \Microsoft\Windows\Flighting\OneSettings\RefreshCache (OneSettings remote-config fetch) to a user-chosen interval, with timestamped backups, verification, rollback, and an optional SYSTEM watchdog that re-applies the cadence after Windows servicing rewrites the task</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="OneSettingsCadence.Core\OneSettingsCadence.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Core project lives in a subfolder; without this exclusion the
         default glob pulls its sources (and its obj-generated AssemblyInfo)
         into this assembly too — duplicate types and attributes. -->
    <Compile Remove="OneSettingsCadence.Core\**" />
  </ItemGroup>

  <!-- Zero-PowerShell core (TECHNICAL_NOTES design rule 1): Task Scheduler is
       reached through the Schedule.Service COM interface, never schtasks.exe
       or PowerShell cmdlets. No package references needed. -->

</Project>
